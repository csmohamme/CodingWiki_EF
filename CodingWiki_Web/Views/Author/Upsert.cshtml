@model Author
@{
    var title = "Create Author";
}
<form method="post">
    @Html.AntiForgeryToken()
    <div class="row p-3 border">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Author_Id" />
        @if (Model.Author_Id != 0)
        {
            //edit
            title = "Edit Author";
        }
        <div class="col-12 border-bottom">
            <h2 class="text-primary">@title</h2>
        </div>
        <div class="col-8 pt-4">
            <div class="form-group row py-2">
                <div class="col-4">
                    <label asp-for="FirstName"></label>
                </div>
                <div class="col-8">
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row py-2">
                <div class="col-4">
                    <label asp-for="LastName"></label>
                </div>
                <div class="col-8">
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row py-2">
                <div class="col-4">
                    <label asp-for="BirthDate"></label>
                </div>
                <div class="col-8">
                    <input type="hidden" asp-for="BirthDate" id="BirthDateHidden" />
                    <input id="BirthDatePicker" class="form-control" placeholder="DD-MM-YYYY" autocomplete="off"
                           value="@(Model.BirthDate != default(DateOnly) ? Model.BirthDate.ToString("dd-MM-yyyy") : "")" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row py-2">
                <div class="col-4">
                    <label asp-for="Location"></label>
                </div>
                <div class="col-8">
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row py-2">
                <div class="col-4 offset-4">
                    @if (Model.Author_Id != 0)
                    {
                        <button type="submit" class="btn btn-primary form-control">Update</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary form-control">Create</button>
                    }
                </div>
                <div class="col-4">
                    <a asp-action="Index" class="btn btn-success form-control">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script>
            flatpickr("#BirthDatePicker", {
            dateFormat: "d-m-Y", // display format
            maxDate: "today",
            allowInput: true,
            defaultDate: "@(Model.BirthDate != default(DateOnly) ? Model.BirthDate.ToString("yyyy-MM-dd") : "")",
            onChange: function(selectedDates, dateStr, instance) {
            if (selectedDates.length > 0) {
            // Send ISO format to hidden input
            var isoDate = selectedDates[0].toISOString().split('T')[0];
            document.getElementById('BirthDateHidden').value = isoDate;
            }
            }
            });

            // In case user typed the date manually
            document.getElementById('BirthDatePicker').addEventListener('change', function() {
            var dateParts = this.value.split('-'); // dd-MM-yyyy
            if (dateParts.length === 3) {
            var isoDate = dateParts[2] + '-' + dateParts[1] + '-' + dateParts[0]; // yyyy-MM-dd
            document.getElementById('BirthDateHidden').value = isoDate;
            }
            });
        </script>
    </script>
}